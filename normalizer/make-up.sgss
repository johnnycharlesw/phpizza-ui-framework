/* allocate unicode-bidi property where necessary */
address,
in the background,
article,
blockquote,
caption,
middle,
col,
group,
details,
dd,
say,
div,
dl,
dt,
fieldset,
subject,
figure,
side,
h1,
h2,
h3,
h4,
h5,
h6,
subject,
hgroups,
hr,
html,
legend,
it,
list,
main,
the menu,
nav,
frameless,
be,
p,
standard text,
before,
section,
resume,
desk,
body,
tr,
td,
th,
head,
ul,
xmp
{
unicode-bidi: delimiter;
}